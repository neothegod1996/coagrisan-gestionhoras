generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model user {
  id         String      @id @default(uuid())
  wp_id      Int?        @unique
  wp_name    String
  wp_email   String      @unique
  role       role        @default(employee)
  status     status      @default(active)
  created_at DateTime    @default(now())
  updated_at DateTime    @updatedAt
  partner_id String?
  user_type  user_type   @default(user)
  employees  employee[]  @relation("PartnerEmployees")
  employee   employee?
  incidences incidence[] @relation("PartnerIncidences")
  locations  location[]  @relation("PartnerLocations")
  profiles   profile[]   @relation("PartnerProfiles")
  schedules  schedule[]  @relation("PartnerSchedules")
  terminals  terminal[]  @relation("PartnerTerminals")

  @@index([wp_id])
  @@index([wp_email])
}

model employee {
  id                String              @id @default(uuid())
  card_id           String?
  first_name        String
  last_name         String?
  dni               String?
  alias             String?
  birth_date        DateTime?
  address           String?
  postal_code       String?
  province          String?
  population        String?
  phone_number      String?
  mobile_number     String?
  email             String?             @unique
  status            status              @default(active)
  user_id           String              @unique
  partner_id        String
  created_at        DateTime            @default(now())
  updated_at        DateTime            @updatedAt
  profile_id        String?
  schedule_id       String?
  location_id       String?
  is_responsible    Boolean             @default(false)
  device_pin        String?
  employee_code     String?
  location          location?           @relation(fields: [location_id], references: [id])
  partner           user                @relation("PartnerEmployees", fields: [partner_id], references: [id])
  profile           profile?            @relation(fields: [profile_id], references: [id])
  schedule          schedule?           @relation(fields: [schedule_id], references: [id])
  user              user                @relation(fields: [user_id], references: [id])
  employee_shift    employee_shift[]
  employee_turnover employee_turnover[]
  task_tracker      task_tracker[]
  incidence         incidence[]         @relation("employeeToincidence")

  @@index([partner_id])
  @@index([location_id], map: "employee_location_id_fkey")
  @@index([profile_id], map: "employee_profile_id_fkey")
  @@index([schedule_id], map: "employee_schedule_id_fkey")
}

model employee_turnover {
  id          String        @id @default(uuid())
  date        DateTime
  type        turnover_type
  employee_id String
  created_at  DateTime      @default(now())
  updated_at  DateTime      @updatedAt
  employee    employee      @relation(fields: [employee_id], references: [id])

  @@index([employee_id])
}

model profile {
  id         String      @id @default(uuid())
  name       String
  status     status      @default(active)
  partner_id String
  created_at DateTime    @default(now())
  updated_at DateTime    @updatedAt
  employee   employee[]
  partner    user        @relation("PartnerProfiles", fields: [partner_id], references: [id])
  incidence  incidence[] @relation("incidenceToprofile")

  @@index([partner_id])
}

model schedule {
  id          String             @id @default(uuid())
  name        String
  description String?
  partner_id  String
  created_at  DateTime           @default(now())
  updated_at  DateTime           @updatedAt
  employee    employee[]
  partner     user               @relation("PartnerSchedules", fields: [partner_id], references: [id])
  days        schedule_days[]
  sessions    schedule_session[]

  @@index([partner_id])
}

model schedule_days {
  id          String       @id @default(uuid())
  day         schedule_day
  schedule_id String
  created_at  DateTime     @default(now())
  updated_at  DateTime     @updatedAt
  schedule    schedule     @relation(fields: [schedule_id], references: [id])

  @@index([schedule_id])
}

model schedule_session {
  id               String           @id @default(uuid())
  start_time       DateTime
  end_time         DateTime
  total_time       Int
  shift_type       shift_type
  has_break        Boolean          @default(false)
  break_start_time DateTime?
  break_end_time   DateTime?
  schedule_id      String
  created_at       DateTime         @default(now())
  updated_at       DateTime         @updatedAt
  employee_shift   employee_shift[]
  schedule         schedule         @relation(fields: [schedule_id], references: [id])

  @@index([schedule_id])
}

model employee_shift {
  id                  String                 @id @default(uuid())
  date                DateTime
  employee_id         String
  created_at          DateTime               @default(now())
  updated_at          DateTime               @updatedAt
  schedule_session_id String?
  employee            employee               @relation(fields: [employee_id], references: [id])
  schedule_session    schedule_session?      @relation(fields: [schedule_session_id], references: [id])
  shift_clock         employee_shift_clock[]

  @@index([employee_id])
  @@index([date])
  @@index([schedule_session_id], map: "employee_shift_schedule_session_id_fkey")
}

model employee_shift_clock {
  id                 String                      @id @default(uuid())
  time               DateTime
  terminal_id        String
  employee_shift_id  String
  created_at         DateTime                    @default(now())
  updated_at         DateTime                    @updatedAt
  status             employee_shift_clock_status @default(pending)
  session_id         String                      @default("default")
  employee_shift     employee_shift              @relation(fields: [employee_shift_id], references: [id], onDelete: Cascade)
  terminal           terminal                    @relation(fields: [terminal_id], references: [id])
  task_tracker_links task_tracker_shift_clock[]

  @@index([employee_shift_id])
  @@index([terminal_id])
}

model incidence {
  id             String         @id @default(uuid())
  start_date     DateTime       @default(now())
  end_date       DateTime       @default(now())
  type           incidence_type
  description    String?
  all_day        Boolean        @default(false)
  paid           Boolean        @default(false)
  is_global      Boolean        @default(false)
  created_at     DateTime       @default(now())
  updated_at     DateTime       @updatedAt
  partner_id     String
  duration_hours Int?
  partner        user           @relation("PartnerIncidences", fields: [partner_id], references: [id])
  employees      employee[]     @relation("employeeToincidence")
  profiles       profile[]      @relation("incidenceToprofile")

  @@index([start_date])
  @@index([end_date])
  @@index([partner_id])
}

model location {
  id         String     @id @default(uuid())
  name       String
  status     status     @default(active)
  partner_id String
  created_at DateTime   @default(now())
  updated_at DateTime   @updatedAt
  employee   employee[]
  partner    user       @relation("PartnerLocations", fields: [partner_id], references: [id])

  @@index([partner_id])
}

model terminal {
  id                   String                 @id @default(uuid())
  external_id          String                 @unique
  name                 String
  connection_status    connection_status      @default(disconnected)
  partner_id           String
  created_at           DateTime               @default(now())
  updated_at           DateTime               @updatedAt
  employee_shift_clock employee_shift_clock[]
  partner              user                   @relation("PartnerTerminals", fields: [partner_id], references: [id])

  @@index([external_id])
  @@index([partner_id], map: "terminal_partner_id_fkey")
}

model task_tracker {
  id                        String                     @id @default(uuid())
  name                      String
  description               String?
  status                    task_tracker_status        @default(pending)
  start_time                DateTime?
  end_time                  DateTime?
  duration                  Int?
  created_at                DateTime                   @default(now())
  updated_at                DateTime                   @updatedAt
  employee_id               String
  employee                  employee                   @relation(fields: [employee_id], references: [id])
  task_tracker_shift_clocks task_tracker_shift_clock[]

  @@index([employee_id])
}

model task_tracker_shift_clock {
  id                      String               @id @default(uuid())
  task_tracker_id         String
  employee_shift_clock_id String
  created_at              DateTime             @default(now())
  employee_shift_clock    employee_shift_clock @relation(fields: [employee_shift_clock_id], references: [id], onDelete: Cascade)
  task_tracker            task_tracker         @relation(fields: [task_tracker_id], references: [id], onDelete: Cascade)

  @@index([task_tracker_id])
  @@index([employee_shift_clock_id])
}

model task_tracker_history {
  id                  String   @id @default(uuid())
  task_tracker_id     String
  user_id             String
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt
  end_time_modified   Boolean? @default(false)
  start_time_modified Boolean? @default(false)

  @@index([task_tracker_id])
  @@index([user_id])
}

enum status {
  active
  inactive
}

enum role {
  admin
  manager
  employee
}

enum user_type {
  user
  farm
}

enum turnover_type {
  hiring
  departure
}

enum schedule_day {
  monday
  tuesday
  wednesday
  thursday
  friday
  saturday
  sunday
}

enum shift_type {
  morning
  afternoon
  night
}

enum employee_shift_clock_status {
  pending
  approved
}

enum incidence_type {
  holiday
  festive
  absence
  medical_leave
  personal_leave
  sindical_leave
  medical_visit
  union_hours
  leave_of_absence
  overtime_rest
  other
}

enum connection_status {
  connected
  failed
  disconnected
}

enum task_tracker_status {
  pending
  running
  completed
  paused
}
